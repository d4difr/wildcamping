# Client-side. Anything with a VITE_ prefix is COMPILED INTO THE JS BUNDLE and is
# public. Never put a secret here — that is how the admin password ended up
# readable at /assets/index-*.js.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_MAPBOX_TOKEN=your-mapbox-token

# Server-side only (Vercel env vars, no VITE_ prefix). These never reach the
# browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_KEY=a-long-random-admin-password
RESEND_API_KEY=your-resend-key
